+<?php
+declare(strict_types=1);
+/** Somente instaladores oficiais, com sistema e arquitetura explícitos. */
+function coletor_download_url(array $release, string $os): string
+{
+    if (!in_array($os, ['windows', 'linux'], true)) throw new InvalidArgumentException('Sistema inválido.');
+    $tag = (string) ($release['tag_name'] ?? '');
+    if (!preg_match('/^v(\d+\.\d+\.\d+)$/D', $tag, $m) || !empty($release['draft']) || !empty($release['prerelease'])) {
+        throw new RuntimeException('Versão oficial indisponível.');
+    }
+    $name = 'atlas-coletor_' . $m[1] . ($os === 'windows' ? '_windows_amd64.exe' : '_ubuntu24.04_amd64.deb');
+    $expected = 'https://github.com/nihause/atlas-coletor-distribuido/releases/download/' . $tag . '/' . $name;
+    foreach (($release['assets'] ?? []) as $asset) {
+        if (($asset['name'] ?? '') === $name && ($asset['browser_download_url'] ?? '') === $expected && ($asset['size'] ?? 0) > 0) return $expected;
+    }
+    throw new RuntimeException('O instalador deste sistema ainda não está disponível na versão oficial.');
+}
