+<?php
+declare(strict_types=1);
+require __DIR__ . '/../lib/bootstrap.php';
+require __DIR__ . '/../lib/coletor_download.php';
+require_admin();
+$os = (string) ($_GET['os'] ?? '');
+if (!in_array($os, ['windows', 'linux'], true)) { http_response_code(400); exit('Escolha Windows ou Linux.'); }
+session_write_close();
+try {
+    // Cache por usuário do PHP, fora do projeto; nunca contém credenciais.
+    $dir = sys_get_temp_dir() . '/radar-atlas-release-' . posix_geteuid();
+    if (!is_dir($dir)) @mkdir($dir, 0700);
+    if (is_link($dir) || !is_dir($dir) || fileowner($dir) !== posix_geteuid()) throw new RuntimeException('Cache indisponível.');
+    $cache = $dir . '/latest.json';
+    $payload = null;
+    if (is_file($cache) && !is_link($cache) && filemtime($cache) > time() - 600) $payload = json_decode((string) file_get_contents($cache), true);
+    if (is_array($payload)) {
+        try { coletor_download_url($payload, $os); } catch (RuntimeException $e) { $payload = null; }
+    }
+    if (!is_array($payload)) {
+        $curl = curl_init('https://api.github.com/repos/nihause/atlas-coletor-distribuido/releases/latest');
+        curl_setopt_array($curl, [CURLOPT_RETURNTRANSFER => true, CURLOPT_CONNECTTIMEOUT => 3, CURLOPT_TIMEOUT => 8, CURLOPT_USERAGENT => 'Radar-Atlas-Download', CURLOPT_HTTPHEADER => ['Accept: application/vnd.github+json'], CURLOPT_FOLLOWLOCATION => false]);
+        $body = curl_exec($curl); $status = curl_getinfo($curl, CURLINFO_RESPONSE_CODE); curl_close($curl);
+        if ($status !== 200 || !is_string($body)) throw new RuntimeException('GitHub indisponível.');
+        $payload = json_decode($body, true, 32, JSON_THROW_ON_ERROR);
+        coletor_download_url($payload, $os);
+        if (!is_link($cache)) { file_put_contents($cache, $body, LOCK_EX); @chmod($cache, 0600); }
+    }
+    header('Cache-Control: no-store');
+    header('Location: ' . coletor_download_url($payload, $os), true, 302);
+} catch (Throwable $e) {
+    http_response_code(503);
+    header('Content-Type: text/html; charset=utf-8');
+    echo '<p>Não foi possível obter o instalador agora. Tente novamente ou escolha o pacote na <a href="https://github.com/nihause/atlas-coletor-distribuido/releases/latest" rel="noreferrer">página oficial de downloads</a>.</p>';
+}
