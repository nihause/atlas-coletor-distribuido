+<?php
+declare(strict_types=1);
+/** Contexto definido exclusivamente pelo servidor autenticado; nunca vem de um item do coletor. */
+function importacao_contexto(?string $novo=null): string
+{
+    static $executor='servidor';
+    if($novo!==null){
+        if($novo!=='servidor'&&!preg_match('/^atlas:[A-Za-z0-9_.:-]{1,64}$/D',$novo))throw new InvalidArgumentException('Executor inválido.');
+        $executor=$novo;
+    }
+    return $executor;
+}
+function importacao_com_executor(string $executor,callable $trabalho): mixed
+{
+    $antes=importacao_contexto();importacao_contexto($executor);
+    try{return $trabalho();}finally{importacao_contexto($antes);}
+}
+/** Deve participar da mesma transação da gravação dos dados. Origem inicial nunca muda. */
+function importacao_registrar(PDO $p,int $processo,string $fonte,bool $novo,bool $publicacaoNova=false): void
+{
+    if(!$p->inTransaction())throw new LogicException('Origem exige a transação da importação.');
+    if($processo<=0||!in_array($fonte,['djen','datajud'],true))throw new InvalidArgumentException('Origem inválida.');
+    $executor=importacao_contexto();
+    $p->prepare('INSERT INTO processo_importacao_origem(processo_id,primeiro_executor,primeira_fonte,primeira_importacao_em,ultimo_executor,ultima_fonte,ultima_recepcao_em)
+        VALUES(?,?,?,IF(?,NOW(6),NULL),?,?,NOW(6)) ON DUPLICATE KEY UPDATE ultimo_executor=VALUES(ultimo_executor),ultima_fonte=VALUES(ultima_fonte),ultima_recepcao_em=VALUES(ultima_recepcao_em)')
+      ->execute([$processo,$novo?$executor:null,$novo?$fonte:null,(int)$novo,$executor,$fonte]);
+    $p->prepare("INSERT INTO coleta_executor_hora(hora,executor,fonte,processos_novos,publicacoes_novas,recepcoes) VALUES(DATE_FORMAT(NOW(),'%Y-%m-%d %H:00:00'),?,?,?,?,1)
+        ON DUPLICATE KEY UPDATE processos_novos=processos_novos+VALUES(processos_novos),publicacoes_novas=publicacoes_novas+VALUES(publicacoes_novas),recepcoes=recepcoes+1")
+      ->execute([$executor,$fonte,(int)$novo,(int)$publicacaoNova]);
+}
+function importacao_rotulo(?string $executor,?string $nome=null): string
+{
+    if(!$executor)return 'Origem não registrada';
+    if($executor==='servidor')return 'Coletor do servidor Radar';
+    $id=substr($executor,6);return 'Coletor '.$id.($nome&&$nome!==$id?' · '.$nome:'');
+}
+const IMPORTACAO_RESUMO_HOJE_SQL="SELECT h.executor,c.nome,SUM(h.processos_novos) processos_novos,SUM(h.publicacoes_novas) publicacoes_novas,
+ SUM(IF(h.fonte='djen',h.recepcoes,0)) recepcoes_djen,SUM(IF(h.fonte='datajud',h.recepcoes,0)) recepcoes_datajud
+ FROM coleta_executor_hora h LEFT JOIN coletores c ON h.executor=CONCAT('atlas:',c.id)
+ WHERE h.hora>=CURDATE() GROUP BY h.executor,c.nome ORDER BY processos_novos DESC,h.executor";
