# Copie para .env (ou deixe o instalador criar) e preencha. NUNCA envie o .env ao Git.
RADAR_API_URL=https://servidor.exemplo.com/radar/api/v1
WORKER_NAME=coletor-01          # único por computador; 3 a 64 caracteres: letras, números e _.:-
WORKER_TOKEN=                   # chave de API deste computador (Radar > Administração > API, permissão "Ingestão")
MAX_CONCURRENCY=4               # tarefas simultâneas (o servidor pode reduzir)
HEARTBEAT_INTERVAL=30           # segundos
LOG_LEVEL=INFO
# Opcionais
# TASK_TYPES=djen_janela,datajud_lote   # tipos que este computador aceita
# DATAJUD_API_KEY=                      # opcional: vazio usa automaticamente a chave pública oficial do CNJ
# STATE_DIR=                            # onde guardar o estado local (padrão: ~/.local/share/atlas-worker ou %LOCALAPPDATA%\atlas-worker)
# REQUEST_TIMEOUT=60                    # segundos por requisição ao servidor
# DATAJUD_TIMEOUT=120                   # segundos por consulta ao DataJud
# ALLOW_INSECURE_HTTP=0                 # só 1 para testes em 127.0.0.1; HTTPS é obrigatório fora disso
